# Copy this file to .env and fill in your own keys.
# Never commit the real .env file — it's already in .gitignore.

# https://home.openweathermap.org/api_keys (free tier is enough)
VITE_OPENWEATHER_KEY=

# https://www.pexels.com/api/ (free, instant approval)
VITE_PEXELS_KEY=

# https://aistudio.google.com/app/apikey (free Gemini API key)
VITE_GEMINI_KEY=
